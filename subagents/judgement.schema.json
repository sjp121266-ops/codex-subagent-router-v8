{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finalAgent",
    "runtimeRole",
    "sandboxMode",
    "selectedSkills",
    "selectedSkillsByPhase",
    "importanceLevel",
    "selectedModel",
    "reasoningEffort",
    "modelRationale",
    "taskProfile",
    "executionPlan",
    "confidence",
    "needsParentChoice",
    "rationale",
    "riskNotes",
    "judgeMode",
    "judgeModel",
    "costRationale",
    "candidateBudget"
  ],
  "properties": {
    "finalAgent": {
      "type": "string"
    },
    "runtimeRole": {
      "type": "string",
      "enum": ["explorer", "worker"]
    },
    "sandboxMode": {
      "type": "string",
      "enum": ["read-only", "workspace-write", "danger-full-access"]
    },
    "selectedSkills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selectedSkillsByPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planning", "research", "design", "implementation", "debugging", "testing", "review", "deployment", "matched", "selected"],
      "properties": {
        "planning": { "type": "array", "items": { "type": "string" } },
        "research": { "type": "array", "items": { "type": "string" } },
        "design": { "type": "array", "items": { "type": "string" } },
        "implementation": { "type": "array", "items": { "type": "string" } },
        "debugging": { "type": "array", "items": { "type": "string" } },
        "testing": { "type": "array", "items": { "type": "string" } },
        "review": { "type": "array", "items": { "type": "string" } },
        "deployment": { "type": "array", "items": { "type": "string" } },
        "matched": { "type": "array", "items": { "type": "string" } },
        "selected": { "type": "array", "items": { "type": "string" } }
      }
    },
    "importanceLevel": {
      "type": "string",
      "enum": ["critical", "high", "normal", "low"]
    },
    "selectedModel": {
      "type": "string",
      "enum": ["gpt-5.5", "gpt-5.4", "gpt-5.4-mini", "gpt-5.3-codex"]
    },
    "reasoningEffort": {
      "type": "string",
      "enum": ["low", "medium", "high", "xhigh"]
    },
    "modelRationale": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "taskProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complexity", "risk", "scope", "writeIntent", "signals"],
      "properties": {
        "complexity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "scope": {
          "type": "string",
          "enum": ["local", "subsystem", "cross-system", "unknown"]
        },
        "writeIntent": {
          "type": "string",
          "enum": ["none", "possible", "expected"]
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "executionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "primaryRole", "stages", "parallelizable", "requiresReview", "requiresTests", "requiresUserClarification"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["single-agent", "staged", "parallel-review", "clarify-first"]
        },
        "primaryRole": {
          "type": "string",
          "enum": ["explorer", "worker"]
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "parallelizable": {
          "type": "boolean"
        },
        "requiresReview": {
          "type": "boolean"
        },
        "requiresTests": {
          "type": "boolean"
        },
        "requiresUserClarification": {
          "type": "boolean"
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "needsParentChoice": {
      "type": "boolean"
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "riskNotes": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "judgeMode": {
      "type": "string",
      "enum": ["deterministic", "mini-judge", "standard-judge", "premium-judge"]
    },
    "judgeModel": {
      "type": "string",
      "enum": ["none", "gpt-5.5", "gpt-5.4", "gpt-5.4-mini"]
    },
    "costRationale": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "candidateBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "skills"],
      "properties": {
        "agents": { "type": "integer", "minimum": 1, "maximum": 8 },
        "skills": { "type": "integer", "minimum": 1, "maximum": 18 }
      }
    }
  }
}
